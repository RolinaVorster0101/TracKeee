@model IEnumerable<TracKeee.Models.Client>

@{
    ViewData["Title"] = "Clients";
}

<div class="page__header">
    <div>
        <h1 class="page__title">Clients</h1>
        <p class="page__subtitle">Manage your clients and contact details.</p>
    </div>
    @{
        var clientRole = await OrgService.GetCurrentRole();
    }
    <div class="page__actions">
        @if (OrgService.HasPermission(clientRole, "ManageClients"))
        {
            <a asp-action="Create" class="btn btn--primary">+ Add Client</a>
        }
    </div>
</div>

<div class="card">
    <div class="card__header">
        <form method="get" style="margin:0;">
            <div class="filter-bar__search" style="width:320px;">
                <svg class="filter-bar__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" name="search" class="form__input" placeholder="Search clients..." value="@ViewBag.Search" />
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a asp-action="Index" class="btn btn--ghost btn--sm" style="position:absolute;right:6px;top:50%;transform:translateY(-50%);color:var(--color-danger);">Clear</a>
                }
            </div>
        </form>
        @if (OrgService.HasPermission(clientRole, "ExportData"))
        {
            <a asp-action="Export" class="btn btn--outline-secondary">Export CSV</a>
        }
    </div>

    @if (!Model.Any())
    {
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <div class="card__body">
                <div class="alert alert--warning">
                    No clients match your search. <a asp-action="Index">Clear search</a> to see all clients.
                </div>
            </div>
        }
        else if (OrgService.HasPermission(clientRole, "ManageClients"))
        {
            <div class="card__body">
                <div class="alert alert--info">
                    You don't have any clients yet. <a asp-action="Create">Add your first client</a> to get started.
                </div>
            </div>
        }
        else
        {
            <div class="card__body">
                <div class="alert alert--info">
                    No clients to display.
                </div>
            </div>
        }
    }
    else
    {
        <div class="card__body card__body--flush">
            <div class="table-wrapper" style="border:none;box-shadow:none;border-radius:0;">
                <table class="table">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Name)</th>
                            <th>@Html.DisplayNameFor(model => model.ContactPerson)</th>
                            <th>@Html.DisplayNameFor(model => model.Email)</th>
                            <th>@Html.DisplayNameFor(model => model.Phone)</th>
                            <th>@Html.DisplayNameFor(model => model.VatNumber)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var initials = string.Join("", (item.Name ?? "?")
                                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                .Take(2)
                                .Select(w => w[0].ToString().ToUpper()));
                            <tr>
                                <td>
                                    <div style="display:flex;align-items:center;gap:var(--space-3);">
                                        <div class="avatar" aria-hidden="true">@initials</div>
                                        <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                                    </div>
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.ContactPerson)</td>
                                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                                <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                                <td>@Html.DisplayFor(modelItem => item.VatNumber)</td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button type="button" class="dropdown__trigger" data-dropdown-trigger
                                                aria-haspopup="true" aria-expanded="false"
                                                aria-label="Actions for @item.Name">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <circle cx="12" cy="5" r="1"/>
                                                <circle cx="12" cy="12" r="1"/>
                                                <circle cx="12" cy="19" r="1"/>
                                            </svg>
                                        </button>
                                        <div class="dropdown__menu" role="menu">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="dropdown__item" role="menuitem">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                    <circle cx="12" cy="12" r="3"/>
                                                </svg>
                                                View
                                            </a>
                                            @if (OrgService.HasPermission(clientRole, "ManageClients"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="dropdown__item" role="menuitem">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                    </svg>
                                                    Edit
                                                </a>
                                            }
                                            @if (OrgService.HasPermission(clientRole, "Delete"))
                                            {
                                                <div class="dropdown__divider" role="separator"></div>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="dropdown__item dropdown__item--danger" role="menuitem">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <polyline points="3 6 5 6 21 6"/>
                                                        <path d="M19 6l-1 14H6L5 6"/>
                                                    </svg>
                                                    Delete
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card__footer">
            <div class="pagination" aria-label="Pagination">
                <span class="pagination__info">Showing 1 to @Model.Count() of @Model.Count() clients</span>
                <button type="button" class="pagination__btn" aria-label="Previous page" disabled>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <button type="button" class="pagination__btn pagination__btn--active" aria-label="Page 1" aria-current="page">1</button>
                <button type="button" class="pagination__btn" aria-label="Next page" disabled>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            </div>
        </div>
    }
</div>