@model TracKeee.Models.Invoice

@{
    ViewData["Title"] = $"Pay Invoice {Model.InvoiceNumber}";
    Layout = "_Layout";
    var profile = ViewBag.BusinessProfile as TracKeee.Models.BusinessProfile;
}

<div class="auth-page" style="align-items:flex-start;padding-top:var(--space-8);">
    <div style="width:100%;max-width:760px;">
        <div class="card">
            <div class="card__body">
                <div style="text-align:center;margin-bottom:var(--space-6);">
                    @if (profile?.LogoData != null)
                    {
                        <img src="@Url.Action("BusinessLogo", "Invoices", new { userId = Model.UserId })" alt="Logo" style="max-height: 60px;margin:0 auto var(--space-2);" /><br />
                    }
                    @if (profile?.LogoData == null)
                    {
                        <img src="~/images/logo.svg" alt="TracKeee" height="40" style="margin:0 auto var(--space-2);" /><br />
                    }
                    <h2>@(profile?.BusinessName ?? "TracKeee")</h2>
                    <p class="text-muted">Invoice Payment</p>
                </div>

                @if (TempData["Message"] != null)
                {
                    <div class="alert alert--info mb-4">@TempData["Message"]</div>
                }

                <div class="dashboard-grid" style="margin-bottom:var(--space-6);">
                    <div>
                        <h4 style="margin-bottom:var(--space-2);">Invoice @Model.InvoiceNumber</h4>
                        <p class="text-muted text-sm" style="margin-bottom:var(--space-1);">Issued: @Model.IssueDate.ToString("dd MMM yyyy")</p>
                        <p class="text-muted text-sm">Due: @Model.DueDate.ToString("dd MMM yyyy")</p>
                    </div>
                    <div style="text-align:right;">
                        <div class="footer__heading" style="color:var(--color-text-muted);margin-bottom:var(--space-2);">Bill To</div>
                        <p style="margin-bottom:0;"><strong>@Model.Client?.Name</strong></p>
                        @if (!string.IsNullOrEmpty(Model.Client?.ContactPerson))
                        {
                            <p class="text-muted text-sm" style="margin-bottom:0;">@Model.Client.ContactPerson</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.Client?.Email))
                        {
                            <p class="text-muted text-sm" style="margin-bottom:0;">@Model.Client.Email</p>
                        }
                    </div>
                </div>

                @if (Model.TimeEntries.Any())
                {
                    <div class="table-wrapper mb-4">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Project</th>
                                    <th>Description</th>
                                    <th class="text-end">Hours</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in Model.TimeEntries.OrderBy(t => t.Date))
                                {
                                    <tr>
                                        <td>@entry.Date.ToString("dd MMM")</td>
                                        <td>@entry.Project?.Name</td>
                                        <td>@(entry.Description ?? "-")</td>
                                        <td class="text-end">@entry.Hours.ToString("N2")</td>
                                        <td class="text-end">R @((entry.Hours * (entry.Project?.HourlyRate ?? 0)).ToString("N2"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div style="display:flex;justify-content:flex-end;margin-bottom:var(--space-6);">
                    <div style="min-width:280px;">
                        <div class="summary-row" style="padding-left:0;padding-right:0;">
                            <span>Subtotal</span>
                            <span>R @Model.Subtotal.ToString("N2")</span>
                        </div>
                        <div class="summary-row" style="padding-left:0;padding-right:0;">
                            <span>VAT (@Model.VatRate%)</span>
                            <span>R @Model.VatAmount.ToString("N2")</span>
                        </div>
                        <div class="summary-row" style="padding-left:0;padding-right:0;border-top:2px solid var(--color-neutral-200);border-bottom:none;">
                            <strong style="font-size:var(--font-size-lg);">Total</strong>
                            <strong style="font-size:var(--font-size-lg);color:var(--color-brand-700);">R @Model.Total.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

                @if (profile != null && !string.IsNullOrEmpty(profile.BankName))
                {
                    <div style="margin-bottom:var(--space-6);padding:var(--space-4);background:var(--color-neutral-50);border-radius:var(--radius-md);">
                        <strong>Banking Details</strong><br />
                        <span>Bank: @profile.BankName</span><br />
                        @if (!string.IsNullOrEmpty(profile.AccountType))
                        {
                            <span>Account Type: @profile.AccountType</span><br />
                        }
                        <span>Account: @profile.AccountNumber</span><br />
                        <span>Branch: @profile.BranchCode</span><br />
                        <span>Reference: @Model.InvoiceNumber</span>
                    </div>
                }

                @if (Model.Status != TracKeee.Models.InvoiceStatus.Paid)
                {
                    <div style="text-align:center;">
                        <form asp-action="ProcessPayment" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn--success btn--lg">Pay R @Model.Total.ToString("N2") with Yoco</button>
                        </form>
                        <p class="text-muted text-sm" style="margin-top:var(--space-2);">Secure payment powered by Yoco</p>
                    </div>
                }
                else
                {
                    <div class="alert alert--success" style="justify-content:center;text-align:center;">
                        <div><strong>This invoice has been paid.</strong> Thank you!</div>
                    </div>
                }
            </div>
        </div>
        <p style="text-align:center;margin-top:var(--space-3);" class="text-muted text-sm">Powered by TracKeee</p>
    </div>
</div>
