@model TracKeee.Models.Invoice

@{
    ViewData["Title"] = $"Pay Invoice {Model.InvoiceNumber}";
    Layout = "_Layout";
    var profile = ViewBag.BusinessProfile as TracKeee.Models.BusinessProfile;
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-center mb-4">
                    @if (profile?.LogoData != null)
                    {
                        <img src="@Url.Action("BusinessLogo", "Invoices", new { userId = Model.UserId })" alt="Logo" style="max-height: 60px;" class="mb-2" /><br />
                    }
                    @if (profile?.LogoData == null)
                    {
                        <img src="~/images/logo.svg" alt="TracKeee" height="40" class="mb-2" /><br />
                    }
                    <h2>@(profile?.BusinessName ?? "TracKeee")</h2>
                    <p class="text-muted">Invoice Payment</p>
                </div>

                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-info">@TempData["Message"]</div>
                }

                <div class="row mb-4">
                    <div class="col-md-6">
                        <h5>Invoice @Model.InvoiceNumber</h5>
                        <p class="text-muted mb-1">Issued: @Model.IssueDate.ToString("dd MMM yyyy")</p>
                        <p class="text-muted">Due: @Model.DueDate.ToString("dd MMM yyyy")</p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <h5>Bill To</h5>
                        <p class="mb-0"><strong>@Model.Client?.Name</strong></p>
                        @if (!string.IsNullOrEmpty(Model.Client?.ContactPerson))
                        {
                            <p class="mb-0 text-muted">@Model.Client.ContactPerson</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.Client?.Email))
                        {
                            <p class="mb-0 text-muted">@Model.Client.Email</p>
                        }
                    </div>
                </div>

                @if (Model.TimeEntries.Any())
                {
                    <table class="table table-sm mb-4">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Project</th>
                                <th>Description</th>
                                <th class="text-end">Hours</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.TimeEntries.OrderBy(t => t.Date))
                            {
                                <tr>
                                    <td>@entry.Date.ToString("dd MMM")</td>
                                    <td>@entry.Project?.Name</td>
                                    <td>@(entry.Description ?? "-")</td>
                                    <td class="text-end">@entry.Hours.ToString("N2")</td>
                                    <td class="text-end">R @((entry.Hours * (entry.Project?.HourlyRate ?? 0)).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <div class="row justify-content-end mb-4">
                    <div class="col-md-5">
                        <table class="table table-sm">
                            <tr>
                                <td>Subtotal</td>
                                <td class="text-end">R @Model.Subtotal.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td>VAT (@Model.VatRate%)</td>
                                <td class="text-end">R @Model.VatAmount.ToString("N2")</td>
                            </tr>
                            <tr class="table-dark">
                                <td><strong>Total</strong></td>
                                <td class="text-end"><strong>R @Model.Total.ToString("N2")</strong></td>
                            </tr>
                        </table>
                    </div>
                </div>

                @if (profile != null && !string.IsNullOrEmpty(profile.BankName))
                {
                    <div class="mb-4">
                        <strong>Banking Details</strong><br />
                        <span>Bank: @profile.BankName</span><br />
                        @if (!string.IsNullOrEmpty(profile.AccountType))
                        {
                            <span>Account Type: @profile.AccountType</span><br />
                        }
                        <span>Account: @profile.AccountNumber</span><br />
                        <span>Branch: @profile.BranchCode</span><br />
                        <span>Reference: @Model.InvoiceNumber</span>
                    </div>
                }

                @if (Model.Status != TracKeee.Models.InvoiceStatus.Paid)
                {
                    <div class="text-center">
                        <form asp-action="ProcessPayment" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-success btn-lg">Pay R @Model.Total.ToString("N2") with Yoco</button>
                        </form>
                        <p class="text-muted mt-2"><small>Secure payment powered by Yoco</small></p>
                    </div>
                }
                else
                {
                    <div class="text-center">
                        <div class="alert alert-success">
                            <strong>This invoice has been paid.</strong> Thank you!
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="text-center mt-3">
            <small class="text-muted">Powered by TracKeee</small>
        </div>
    </div>
</div>