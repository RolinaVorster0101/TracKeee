@model TracKeee.Models.Invoice

@{
    ViewData["Title"] = "Payment Successful";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm">
            <div class="card-body py-5">
                <img src="~/images/logo.svg" alt="TracKeee" height="40" class="mb-3" /><br />
                <h1 class="text-success mb-3">✓</h1>
                <h2>Payment Successful!</h2>
                <p class="text-muted mt-3">
                    Thank you for your payment of <strong>R @Model?.Total.ToString("N2")</strong>
                    for invoice <strong>@Model?.InvoiceNumber</strong>.
                </p>
                <p class="text-muted">A confirmation has been recorded.</p>
            </div>
        </div>
    </div>
</div>