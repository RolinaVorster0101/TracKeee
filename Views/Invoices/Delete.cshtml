@model TracKeee.Models.Invoice

@{
    ViewData["Title"] = "Delete Invoice";
}

<div class="page__header">
    <div>
        <h1 class="page__title">Delete Invoice</h1>
        <p class="page__subtitle">Review the details before confirming.</p>
    </div>
</div>

<div>
    <div class="alert alert--danger mb-4">
        <div>
            <strong>Are you sure you want to delete this invoice?</strong><br />
            This will unlink all associated time entries and mark them as uninvoiced.
        </div>
    </div>

    <div class="card">
        <div class="card__body">
            <dl class="dl">
                <dt>@Html.DisplayNameFor(model => model.InvoiceNumber)</dt>
                <dd>@Model.InvoiceNumber</dd>

                <dt>@Html.DisplayNameFor(model => model.Client)</dt>
                <dd>@Model.Client?.Name</dd>

                <dt>@Html.DisplayNameFor(model => model.IssueDate)</dt>
                <dd>@Model.IssueDate.ToString("dd MMM yyyy")</dd>

                <dt>@Html.DisplayNameFor(model => model.Total)</dt>
                <dd><strong>R @Model.Total.ToString("N2")</strong></dd>

                <dt>@Html.DisplayNameFor(model => model.Status)</dt>
                <dd>@Model.Status</dd>
            </dl>
        </div>
        <div class="card__footer">
            <form asp-action="Delete" class="form__actions" style="margin:0;">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn--danger">Delete Invoice</button>
                <a asp-action="Index" class="btn btn--secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
