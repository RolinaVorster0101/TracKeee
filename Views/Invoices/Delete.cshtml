@model TracKeee.Models.Invoice

@{
    ViewData["Title"] = "Delete Invoice";
}

<h1>Delete Invoice</h1>

<div class="alert alert-warning">
    <strong>Are you sure you want to delete this invoice?</strong><br />
    This will unlink all associated time entries and mark them as uninvoiced.
</div>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.InvoiceNumber)</dt>
    <dd class="col-sm-9">@Model.InvoiceNumber</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Client)</dt>
    <dd class="col-sm-9">@Model.Client?.Name</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IssueDate)</dt>
    <dd class="col-sm-9">@Model.IssueDate.ToString("dd MMM yyyy")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Total)</dt>
    <dd class="col-sm-9"><strong>R @Model.Total.ToString("N2")</strong></dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete Invoice</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>