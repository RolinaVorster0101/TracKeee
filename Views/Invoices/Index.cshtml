@model IEnumerable<TracKeee.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Invoices</h1>
    @{
        var invoiceRole = await OrgService.GetCurrentRole();
    }
    @if (OrgService.HasPermission(invoiceRole, "ManageInvoices"))
    {
        <a asp-action="Generate" class="btn btn-primary">+ Generate Invoice</a>
        @if (OrgService.HasPermission(invoiceRole, "ExportData"))
        {
            <a asp-action="Export" class="btn btn-outline-secondary">Export CSV</a>
        }
    }
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<form method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-3">
            <input type="text" name="search" class="form-control" placeholder="Search invoice # or client..." value="@ViewBag.Search" />
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="Draft" selected="@(ViewBag.Status == "Draft")">Draft</option>
                <option value="Sent" selected="@(ViewBag.Status == "Sent")">Sent</option>
                <option value="Paid" selected="@(ViewBag.Status == "Paid")">Paid</option>
                <option value="Overdue" selected="@(ViewBag.Status == "Overdue")">Overdue</option>
                <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
            </select>
        </div>
        <div class="col-md-2">
            <input type="date" name="dateFrom" class="form-control" value="@ViewBag.DateFrom" placeholder="From" />
        </div>
        <div class="col-md-2">
            <input type="date" name="dateTo" class="form-control" value="@ViewBag.DateTo" placeholder="To" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">Filter</button>
        </div>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.Status as string) || ViewBag.DateFrom != null || ViewBag.DateTo != null)
        {
            <div class="col-auto">
                <a asp-action="Index" class="btn btn-outline-danger">Clear</a>
            </div>
        }
    </div>
</form>

@if (!Model.Any())
{
    @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.Status as string) || ViewBag.DateFrom != null || ViewBag.DateTo != null)
    {
        <div class="alert alert-warning">
            No invoices match your filters. <a asp-action="Index">Clear filters</a> to see all invoices.
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No invoices yet. <a asp-action="Generate">Generate your first invoice</a> from logged time entries.
        </div>
    }
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.InvoiceNumber)</th>
                    <th>@Html.DisplayNameFor(model => model.Client)</th>
                    <th>@Html.DisplayNameFor(model => model.IssueDate)</th>
                    <th>@Html.DisplayNameFor(model => model.DueDate)</th>
                    <th class="text-end">@Html.DisplayNameFor(model => model.Total)</th>
                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.InvoiceNumber</strong></td>
                        <td>@item.Client?.Name</td>
                        <td>@item.IssueDate.ToString("dd MMM yyyy")</td>
                        <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                        <td class="text-end"><strong>R @item.Total.ToString("N2")</strong></td>
                        <td>
                            <span class="badge @GetStatusBadgeClass(item.Status)">
                                @item.Status
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            @if (OrgService.HasPermission(invoiceRole, "Delete"))
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@functions {
    string GetStatusBadgeClass(TracKeee.Models.InvoiceStatus status)
    {
        return status switch
        {
            TracKeee.Models.InvoiceStatus.Draft => "bg-warning text-dark",
            TracKeee.Models.InvoiceStatus.Sent => "bg-primary",
            TracKeee.Models.InvoiceStatus.Paid => "bg-success",
            TracKeee.Models.InvoiceStatus.Overdue => "bg-danger",
            TracKeee.Models.InvoiceStatus.Cancelled => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}