@model IEnumerable<TracKeee.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Invoices</h1>
    <a asp-action="Generate" class="btn btn-primary">+ Generate Invoice</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No invoices yet. <a asp-action="Generate">Generate your first invoice</a> from logged time entries.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.InvoiceNumber)</th>
                    <th>@Html.DisplayNameFor(model => model.Client)</th>
                    <th>@Html.DisplayNameFor(model => model.IssueDate)</th>
                    <th>@Html.DisplayNameFor(model => model.DueDate)</th>
                    <th class="text-end">@Html.DisplayNameFor(model => model.Total)</th>
                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.InvoiceNumber</strong></td>
                        <td>@item.Client?.Name</td>
                        <td>@item.IssueDate.ToString("dd MMM yyyy")</td>
                        <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                        <td class="text-end"><strong>R @item.Total.ToString("N2")</strong></td>
                        <td>
                            <span class="badge @GetStatusBadgeClass(item.Status)">
                                @item.Status
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@functions {
    string GetStatusBadgeClass(TracKeee.Models.InvoiceStatus status)
    {
        return status switch
        {
            TracKeee.Models.InvoiceStatus.Draft => "bg-warning text-dark",
            TracKeee.Models.InvoiceStatus.Sent => "bg-primary",
            TracKeee.Models.InvoiceStatus.Paid => "bg-success",
            TracKeee.Models.InvoiceStatus.Overdue => "bg-danger",
            TracKeee.Models.InvoiceStatus.Cancelled => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}