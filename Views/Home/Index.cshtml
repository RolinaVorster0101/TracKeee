@using TracKeee.Models
@{
    ViewData["Title"] = "Home";
}

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    var dashRole = ViewBag.UserRole != null ? (OrganizationRole)ViewBag.UserRole : OrganizationRole.Employee;

    <h1 class="mb-4">Dashboard</h1>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h2 class="mb-0">@ViewBag.TotalClients</h2>
                    <small class="text-muted">Clients</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h2 class="mb-0">@ViewBag.ActiveProjects</h2>
                    <small class="text-muted">Active Projects</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h2 class="mb-0">@(((decimal)ViewBag.HoursThisMonth).ToString("N1"))h</h2>
                    <small class="text-muted">Hours This Month</small>
                </div>
            </div>
        </div>
        @if (OrgService.HasPermission(dashRole, "ViewFinancials"))
        {
            <div class="col-md-3 mb-3">
                <div class="card border-0 shadow-sm bg-success bg-opacity-10">
                    <div class="card-body text-center">
                        <h2 class="mb-0">R @(((decimal)ViewBag.UninvoicedAmount).ToString("N2"))</h2>
                        <small class="text-muted">Uninvoiced</small>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <a asp-controller="TimeEntries" asp-action="Create" class="btn btn-primary me-2">+ Log Time</a>
            @if (OrgService.HasPermission(dashRole, "ManageClients"))
            {
                <a asp-controller="Clients" asp-action="Create" class="btn btn-outline-primary me-2">+ Add Client</a>
                <a asp-controller="Projects" asp-action="Create" class="btn btn-outline-primary me-2">+ Add Project</a>
            }
            @if (OrgService.HasPermission(dashRole, "ManageInvoices"))
            {
                <a asp-controller="Invoices" asp-action="Generate" class="btn btn-outline-success">+ Generate Invoice</a>
            }
        </div>
    </div>

    <div class="row">
        <!-- Recent Time Entries -->
        <div class="@(OrgService.HasPermission(dashRole, "ViewFinancials") ? "col-md-7" : "col-12") mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <strong>Recent Time Entries</strong>
                    <a asp-controller="TimeEntries" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All</a>
                </div>
                <div class="card-body p-0">
                    @{
                        var recentEntries = ViewBag.RecentTimeEntries as List<TimeEntry>;
                    }
                    @if (recentEntries != null && recentEntries.Any())
                    {
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Project</th>
                                    <th class="text-end">Hours</th>
                                    @if (OrgService.HasPermission(dashRole, "ViewFinancials"))
                                    {
                                        <th class="text-end">Amount</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in recentEntries)
                                {
                                    <tr>
                                        <td>@entry.Date.ToString("dd MMM")</td>
                                        <td>
                                            <small class="text-muted">@entry.Project?.Client?.Name</small><br />
                                            @entry.Project?.Name
                                        </td>
                                        <td class="text-end">@entry.Hours.ToString("N2")</td>
                                        @if (OrgService.HasPermission(dashRole, "ViewFinancials"))
                                        {
                                            <td class="text-end">R @((entry.Hours * (entry.Project?.HourlyRate ?? 0)).ToString("N2"))</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="p-3 text-muted">No time entries yet. <a asp-controller="TimeEntries" asp-action="Create">Log your first hours.</a></div>
                    }
                </div>
            </div>
        </div>

        @if (OrgService.HasPermission(dashRole, "ViewFinancials"))
        {
            <!-- Recent Invoices & Summary -->
            <div class="col-md-5 mb-4">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <strong>Recent Invoices</strong>
                        <a asp-controller="Invoices" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All</a>
                    </div>
                    <div class="card-body p-0">
                        @{
                            var recentInvoices = ViewBag.RecentInvoices as List<Invoice>;
                        }
                        @if (recentInvoices != null && recentInvoices.Any())
                        {
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Invoice</th>
                                        <th>Client</th>
                                        <th class="text-end">Total</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var inv in recentInvoices)
                                    {
                                        <tr>
                                            <td><a asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.Id">@inv.InvoiceNumber</a></td>
                                            <td>@inv.Client?.Name</td>
                                            <td class="text-end">R @inv.Total.ToString("N2")</td>
                                            <td>
                                                <span class="badge @GetStatusBadge(inv.Status)">@inv.Status</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="p-3 text-muted">No invoices yet.</div>
                        }
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted mb-3">Summary</h6>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Total Hours Logged</span>
                            <strong>@(((decimal)ViewBag.TotalHours).ToString("N1"))h</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Total Invoices</span>
                            <strong>@ViewBag.TotalInvoices</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Outstanding Amount</span>
                            <strong class="text-danger">R @(((decimal)ViewBag.UnpaidInvoices).ToString("N2"))</strong>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Charts -->
    <div class="row mb-4">
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted mb-3">Hours by Month</h6>
                    <div style="height: 200px;"><canvas id="hoursChart"></canvas></div>
                </div>
            </div>
        </div>
        @if (OrgService.HasPermission(dashRole, "ViewFinancials"))
        {
            <div class="col-md-4 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted mb-3">Revenue by Month</h6>
                        <div style="height: 200px;"><canvas id="revenueChart"></canvas></div>
                    </div>
                </div>
            </div>
        }
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted mb-3">Hours by Client</h6>
                    <div style="height: 200px;"><canvas id="clientsChart"></canvas></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Projects -->
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <strong>Recent Projects</strong>
                    <a asp-controller="Projects" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All</a>
                </div>
                <div class="card-body p-0">
                    @{
                        var recentProjects = ViewBag.RecentProjects as List<Project>;
                    }
                    @if (recentProjects != null && recentProjects.Any())
                    {
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Project</th>
                                    <th>Client</th>
                                    @if (OrgService.HasPermission(dashRole, "ViewFinancials"))
                                    {
                                        <th class="text-end">Hourly Rate</th>
                                    }
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var project in recentProjects)
                                {
                                    <tr>
                                        <td><strong>@project.Name</strong></td>
                                        <td>@project.Client?.Name</td>
                                        @if (OrgService.HasPermission(dashRole, "ViewFinancials"))
                                        {
                                            <td class="text-end">R @project.HourlyRate.ToString("N2")</td>
                                        }
                                        <td>
                                            <span class="badge @GetProjectStatusBadge(project.Status)">@project.Status</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        @if (OrgService.HasPermission(dashRole, "ManageProjects"))
                        {
                            <div class="p-3 text-muted">No projects yet. <a asp-controller="Projects" asp-action="Create">Add your first project.</a></div>
                        }
                        else
                        {
                            <div class="p-3 text-muted">No projects assigned to you yet.</div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Landing Page for Visitors -->
    <div class="text-center py-5">
        <img src="~/images/logo.svg" alt="TracKeee" height="72" class="mb-3" /><br />
        <p class="lead mb-4">Time tracking, invoicing, and client management<br />built for South African freelancers and small agencies.</p>

        <div class="mb-5">
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg me-2">Get Started Free</a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-secondary btn-lg">Login</a>
        </div>

        <div class="row justify-content-center mt-5">
            <div class="col-md-3 mb-4">
                <h4>Track Time</h4>
                <p class="text-muted">Log hours against projects and clients. See what you've earned in real time.</p>
            </div>
            <div class="col-md-3 mb-4">
                <h4>Invoice with VAT</h4>
                <p class="text-muted">Generate professional invoices with SA VAT (15%) calculated automatically.</p>
            </div>
            <div class="col-md-3 mb-4">
                <h4>Get Paid</h4>
                <p class="text-muted">Track invoice status from draft to paid. Know exactly what's outstanding.</p>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/charts.js"></script>
}

@functions {
    string GetStatusBadge(InvoiceStatus status)
    {
        return status switch
        {
            InvoiceStatus.Draft => "bg-warning text-dark",
            InvoiceStatus.Sent => "bg-primary",
            InvoiceStatus.Paid => "bg-success",
            InvoiceStatus.Overdue => "bg-danger",
            InvoiceStatus.Cancelled => "bg-secondary",
            _ => "bg-secondary"
        };
    }
    string GetProjectStatusBadge(ProjectStatus status)
    {
        return status switch
        {
            ProjectStatus.Active => "bg-success",
            ProjectStatus.OnHold => "bg-warning text-dark",
            ProjectStatus.Completed => "bg-secondary",
            ProjectStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };
    }
}