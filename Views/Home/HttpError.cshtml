@{
    ViewData["Title"] = $"Error {ViewBag.ErrorCode}";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0">
            <div class="card-body py-5">
                <h1 class="display-1 text-muted mb-3">@ViewBag.ErrorCode</h1>
                <h2>@ViewBag.ErrorMessage</h2>
                <p class="text-muted mt-3">
                    @switch ((int)ViewBag.ErrorCode)
                    {
                        case 404:
                            <span>The page you're looking for doesn't exist or has been moved.</span>
                            break;
                        case 403:
                            <span>You don't have permission to access this page.</span>
                            break;
                        case 500:
                            <span>We're working on fixing this. Please try again later.</span>
                            break;
                        default:
                            <span>Something unexpected happened.</span>
                            break;
                    }
                </p>
                <a href="/" class="btn btn-primary mt-3">Back to Home</a>
            </div>
        </div>
    </div>
</div>