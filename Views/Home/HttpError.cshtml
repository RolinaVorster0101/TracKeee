@{
    ViewData["Title"] = $"Error {ViewBag.ErrorCode}";
}

<div class="auth-page">
    <div class="auth-card" style="text-align:center;">
        <div style="font-size:64px;font-weight:800;color:var(--color-neutral-300);line-height:1;margin-bottom:var(--space-4);">@ViewBag.ErrorCode</div>
        <h1 class="auth-card__title">@ViewBag.ErrorMessage</h1>
        <p class="auth-card__subtitle">
            @switch ((int)ViewBag.ErrorCode)
            {
                case 404:
                    <span>The page you're looking for doesn't exist or has been moved.</span>
                    break;
                case 403:
                    <span>You don't have permission to access this page.</span>
                    break;
                case 500:
                    <span>We're working on fixing this. Please try again later.</span>
                    break;
                default:
                    <span>Something unexpected happened.</span>
                    break;
            }
        </p>
        <div style="display:flex;gap:var(--space-3);justify-content:center;flex-wrap:wrap;margin-top:var(--space-2);">
            <a href="/" class="btn btn--primary">Back to Home</a>
        </div>
    </div>
</div>
