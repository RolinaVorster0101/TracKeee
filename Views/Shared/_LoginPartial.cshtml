@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="sidebar__user">
        <div class="sidebar__user-info">
            <a id="manage" class="sidebar__user-name" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">@UserManager.GetUserName(User)</a>
            <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" style="margin-top:4px;">
                <button id="logout" type="submit" class="sidebar__user-email" style="background:none;border:none;padding:0;cursor:pointer;font-family:inherit;text-align:left;">Logout</button>
            </form>
        </div>
    </div>
}
else
{
    <div style="display:flex;flex-direction:column;gap:8px;">
        <a id="register" class="btn btn--primary btn--sm btn--full" asp-area="Identity" asp-page="/Account/Register">Register</a>
        <a id="login" class="btn btn--outline btn--sm btn--full" style="border-color:rgba(255,255,255,0.3);color:rgba(255,255,255,0.7);" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </div>
}
