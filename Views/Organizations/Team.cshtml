@model List<TracKeee.ViewModels.TeamMemberViewModel>
@using TracKeee.Models

@{
    ViewData["Title"] = "Team Management";
}

<div class="page__header">
    <div>
        <h1 class="page__title">Team</h1>
        <p class="page__subtitle">@ViewBag.OrganizationName</p>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert--info mb-4">@TempData["Message"]</div>
}

<!-- Invite Form -->
<div class="card mb-4">
    <div class="card__header">
        <span class="card__title">Invite Team Member</span>
    </div>
    <div class="card__body">
        <p class="text-muted mb-4" style="font-size:var(--font-size-sm);">The person must have a registered TracKeee account first.</p>
        <form asp-action="Invite" method="post" style="display:flex;align-items:flex-end;gap:var(--space-4);flex-wrap:wrap;">
            <div class="form__group" style="flex:1;min-width:220px;">
                <label class="form__label">Email Address</label>
                <input name="email" type="email" class="form__input" placeholder="colleague@example.com" required />
            </div>
            <div class="form__group" style="min-width:180px;">
                <label class="form__label">Role</label>
                <select name="role" class="form__select">
                    <option value="@OrganizationRole.Admin">Admin</option>
                    <option value="@OrganizationRole.Manager">Manager</option>
                    <option value="@OrganizationRole.Accountant">Accountant</option>
                    <option value="@OrganizationRole.Employee" selected>Employee</option>
                </select>
            </div>
            <div class="form__group">
                <button type="submit" class="btn btn--primary">Invite</button>
            </div>
        </form>
    </div>
</div>

<!-- Team Members -->
<div class="card">
    <div class="card__header">
        <span class="card__title">Team Members</span>
    </div>
    <div class="card__body card__body--flush">
        <div class="table-wrapper" style="border:none;box-shadow:none;border-radius:0;">
            <table class="table">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Joined</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model)
                    {
                        <tr>
                            <td><strong>@member.Email</strong></td>
                            <td>
                                <span class="badge @GetRoleBadge(member.Role)">@member.Role</span>
                            </td>
                            <td>@member.JoinedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                @if (member.Role != OrganizationRole.Owner)
                                {
                                    <div style="display:inline-flex;align-items:center;gap:var(--space-2);">
                                        <form asp-action="ChangeRole" method="post" style="display:inline;">
                                            <input type="hidden" name="memberId" value="@member.MemberId" />
                                            <select name="newRole" class="form__select" style="width:auto;padding-top:var(--space-2);padding-bottom:var(--space-2);" onchange="this.form.submit()">
                                                <option value="" disabled selected>Change role</option>
                                                <option value="@OrganizationRole.Admin">Admin</option>
                                                <option value="@OrganizationRole.Manager">Manager</option>
                                                <option value="@OrganizationRole.Accountant">Accountant</option>
                                                <option value="@OrganizationRole.Employee">Employee</option>
                                            </select>
                                        </form>
                                        <form asp-action="RemoveMember" method="post" style="display:inline;">
                                            <input type="hidden" name="memberId" value="@member.MemberId" />
                                            <button type="submit" class="btn btn--sm btn--outline-danger" onclick="return confirm('Remove this team member?')">Remove</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    string GetRoleBadge(OrganizationRole role)
    {
        return role switch
        {
            OrganizationRole.Owner => "badge--dark",
            OrganizationRole.Admin => "badge--info",
            OrganizationRole.Accountant => "badge--info",
            OrganizationRole.Employee => "badge--neutral",
            _ => "badge--neutral"
        };
    }
}
