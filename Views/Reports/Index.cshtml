@using TracKeee.Models
@{
    ViewData["Title"] = "Reports";
}

<div class="page__header">
    <div>
        <h1 class="page__title">Reports</h1>
        <p class="page__subtitle">Insights into your hours, value, and invoicing.</p>
    </div>
</div>

<div class="card mb-4">
    <div class="card__body">
        <form method="get" style="margin:0;display:flex;align-items:flex-end;gap:var(--space-4);flex-wrap:wrap;">
            <div class="form__group">
                <label class="form__label">From</label>
                <input type="date" name="dateFrom" class="form__input" value="@ViewBag.DateFrom" style="width:auto;" />
            </div>
            <div class="form__group">
                <label class="form__label">To</label>
                <input type="date" name="dateTo" class="form__input" value="@ViewBag.DateTo" style="width:auto;" />
            </div>
            <div class="form__group">
                <button type="submit" class="btn btn--primary" style="padding-top:var(--space-3);padding-bottom:var(--space-3);">Update</button>
            </div>
        </form>
    </div>
</div>

<!-- Summary Cards -->
<div class="stats-grid mb-4">
    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="stat-card__top">
            <div class="stat-card__label">Total Hours</div>
            <div class="stat-card__value">@(((decimal)ViewBag.TotalHours).ToString("N1"))h</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div class="stat-card__top">
            <div class="stat-card__label">Total Value</div>
            <div class="stat-card__value">R @(((decimal)ViewBag.TotalValue).ToString("N2"))</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--green">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div class="stat-card__top">
            <div class="stat-card__label">Paid</div>
            <div class="stat-card__value" style="color:var(--color-success);">R @(((decimal)ViewBag.TotalPaid).ToString("N2"))</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card__icon stat-card__icon--red">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div class="stat-card__top">
            <div class="stat-card__label">Outstanding</div>
            <div class="stat-card__value" style="color:var(--color-danger);">R @(((decimal)ViewBag.TotalUnpaid).ToString("N2"))</div>
        </div>
    </div>
</div>

<div class="dashboard-grid mb-4">
    <!-- Hours by Client -->
    <div class="card">
        <div class="card__header">
            <span class="card__title">Hours by Client</span>
        </div>
        <div class="card__body card__body--flush">
            <div class="table-wrapper" style="border:none;box-shadow:none;border-radius:0;">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th class="text-end">Hours</th>
                            <th class="text-end">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.HoursByClient != null)
                        {
                            @foreach (var item in ViewBag.HoursByClient)
                            {
                                <tr>
                                    <td>@item.Client</td>
                                    <td class="text-end">@(((decimal)item.Hours).ToString("N1"))</td>
                                    <td class="text-end">R @(((decimal)item.Value).ToString("N2"))</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Hours by Project -->
    <div class="card">
        <div class="card__header">
            <span class="card__title">Hours by Project</span>
        </div>
        <div class="card__body card__body--flush">
            <div class="table-wrapper" style="border:none;box-shadow:none;border-radius:0;">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th>Client</th>
                            <th class="text-end">Hours</th>
                            <th class="text-end">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.HoursByProject != null)
                        {
                            @foreach (var item in ViewBag.HoursByProject)
                            {
                                <tr>
                                    <td><strong>@item.Project</strong></td>
                                    <td><small class="text-muted">@item.Client</small></td>
                                    <td class="text-end">@(((decimal)item.Hours).ToString("N1"))</td>
                                    <td class="text-end">R @(((decimal)item.Value).ToString("N2"))</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Invoice Breakdown -->
<div class="card">
    <div class="card__header">
        <span class="card__title">Invoices in Period</span>
    </div>
    <div class="card__body card__body--flush">
        @{
            var invoiceList = ViewBag.InvoiceBreakdown as List<Invoice>;
        }
        @if (invoiceList != null && invoiceList.Any())
        {
            <div class="table-wrapper" style="border:none;box-shadow:none;border-radius:0;">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Client</th>
                            <th>Date</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-end">VAT</th>
                            <th class="text-end">Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in invoiceList)
                        {
                            <tr>
                                <td><a asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.Id">@inv.InvoiceNumber</a></td>
                                <td>@inv.Client?.Name</td>
                                <td>@inv.IssueDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end">R @inv.Subtotal.ToString("N2")</td>
                                <td class="text-end">R @inv.VatAmount.ToString("N2")</td>
                                <td class="text-end"><strong>R @inv.Total.ToString("N2")</strong></td>
                                <td>
                                    <span class="badge @GetStatusBadge(inv.Status)">@inv.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3"><strong>Total</strong></td>
                            <td class="text-end"><strong>R @invoiceList.Sum(i => i.Subtotal).ToString("N2")</strong></td>
                            <td class="text-end"><strong>R @invoiceList.Sum(i => i.VatAmount).ToString("N2")</strong></td>
                            <td class="text-end"><strong>R @invoiceList.Sum(i => i.Total).ToString("N2")</strong></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="card__body text-muted">No invoices in this period.</div>
        }
    </div>
</div>

@functions {
    string GetStatusBadge(InvoiceStatus status)
    {
        return status switch
        {
            InvoiceStatus.Draft => "badge--warning",
            InvoiceStatus.Sent => "badge--info",
            InvoiceStatus.Paid => "badge--success",
            InvoiceStatus.Overdue => "badge--danger",
            InvoiceStatus.Cancelled => "badge--neutral",
            _ => "badge--neutral"
        };
    }
}
