@model TracKeee.Models.TimeEntry

@{
    ViewData["Title"] = "Edit Time Entry";
}

<div class="page__header">
    <div>
        <h1 class="page__title">Edit Time Entry</h1>
        <p class="page__subtitle">Update this logged time entry.</p>
    </div>
</div>

<div>
    <div class="card">
        <div class="card__body">
            <form asp-action="Edit" class="form">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                <input type="hidden" asp-for="Id" />

                <div class="form__group">
                    <label asp-for="ProjectId" class="form__label"></label>
                    <select asp-for="ProjectId" class="form__select" asp-items="ViewBag.ProjectId">
                        <option value="">-- Select a project --</option>
                    </select>
                    <span asp-validation-for="ProjectId" class="form__error"></span>
                </div>

                <div class="form__row form__row--2">
                    <div class="form__group">
                        <label asp-for="Date" class="form__label"></label>
                        <input asp-for="Date" class="form__input" />
                        <span asp-validation-for="Date" class="form__error"></span>
                    </div>

                    <div class="form__group">
                        <label asp-for="Hours" class="form__label"></label>
                        <input asp-for="Hours" class="form__input" step="0.25" />
                        <span asp-validation-for="Hours" class="form__error"></span>
                    </div>
                </div>

                <div class="form__group">
                    <label asp-for="Description" class="form__label"></label>
                    <textarea asp-for="Description" class="form__textarea" rows="3"></textarea>
                    <span asp-validation-for="Description" class="form__error"></span>
                </div>

                <div class="form__actions">
                    <input type="submit" value="Save Changes" class="btn btn--primary" />
                    <a asp-action="Index" class="btn btn--secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
