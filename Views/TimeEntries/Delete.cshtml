@model TracKeee.Models.TimeEntry

@{
    ViewData["Title"] = "Delete Time Entry";
}

<div class="page__header">
    <div>
        <h1 class="page__title">Delete Time Entry</h1>
        <p class="page__subtitle">Review the details before confirming.</p>
    </div>
</div>

<div>
    <div class="alert alert--danger mb-4">
        <div>
            <strong>Are you sure you want to delete this time entry?</strong><br />
            This action cannot be undone.
        </div>
    </div>

    <div class="card">
        <div class="card__body">
            <dl class="dl">
                <dt>Client</dt>
                <dd>@Model.Project?.Client?.Name</dd>

                <dt>@Html.DisplayNameFor(model => model.Project)</dt>
                <dd>@Model.Project?.Name</dd>

                <dt>@Html.DisplayNameFor(model => model.Date)</dt>
                <dd>@Model.Date.ToString("dd MMM yyyy")</dd>

                <dt>@Html.DisplayNameFor(model => model.Hours)</dt>
                <dd>@Model.Hours.ToString("N2") hours</dd>

                <dt>@Html.DisplayNameFor(model => model.Description)</dt>
                <dd>@(Model.Description ?? "-")</dd>
            </dl>
        </div>
        <div class="card__footer">
            <form asp-action="Delete" class="form__actions" style="margin:0;">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn--danger">Delete Time Entry</button>
                <a asp-action="Index" class="btn btn--secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
