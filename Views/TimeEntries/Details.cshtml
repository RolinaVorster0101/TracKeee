@model TracKeee.Models.TimeEntry

@{
    ViewData["Title"] = "Time Entry Details";
}

<h1>Time Entry</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Client</dt>
    <dd class="col-sm-9">@Model.Project?.Client?.Name</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Project)</dt>
    <dd class="col-sm-9">@Model.Project?.Name</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Date)</dt>
    <dd class="col-sm-9">@Model.Date.ToString("dd MMM yyyy")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Hours)</dt>
    <dd class="col-sm-9">@Model.Hours.ToString("N2") hours</dd>

    <dt class="col-sm-3">Amount</dt>
    <dd class="col-sm-9">R @((Model.Hours * (Model.Project?.HourlyRate ?? 0)).ToString("N2"))</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Description)</dt>
    <dd class="col-sm-9">@(Model.Description ?? "-")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IsInvoiced)</dt>
    <dd class="col-sm-9">
        @if (Model.IsInvoiced)
        {
            <span class="badge bg-secondary">Invoiced</span>
        }
        else
        {
            <span class="badge bg-success">Pending</span>
        }
    </dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
</dl>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>