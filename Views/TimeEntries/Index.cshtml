@model IEnumerable<TracKeee.Models.TimeEntry>

@{
    ViewData["Title"] = "Time Entries";
}

<div class="page__header">
    <div>
        <h1 class="page__title">Time Entries</h1>
        <p class="page__subtitle">All the hours you've logged across projects.</p>
    </div>
    <div class="page__actions">
        @if (OrgService.HasPermission(await OrgService.GetCurrentRole(), "ExportData"))
        {
            <a asp-action="Export" class="btn btn--outline-secondary">Export CSV</a>
        }
        <a asp-action="Create" class="btn btn--primary">+ Log Time</a>
    </div>
</div>

<div class="card">
    <div class="card__header">
        <form method="get" style="margin:0;display:flex;align-items:center;gap:var(--space-3);flex-wrap:wrap;width:100%;">
            <div class="filter-bar__search" style="width:240px;">
                <svg class="filter-bar__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" name="search" class="form__input" placeholder="Search description, project..." value="@ViewBag.Search" />
            </div>
            <select name="projectId" class="form__select" style="width:auto;" onchange="this.form.submit()">
                <option value="">All Projects</option>
                @if (ViewBag.Projects != null)
                {
                    @foreach (var p in ViewBag.Projects)
                    {
                        <option value="@p.Id" selected="@(ViewBag.ProjectId != null && ViewBag.ProjectId == p.Id)">@p.Name</option>
                    }
                }
            </select>
            <input type="date" name="dateFrom" class="form__input" value="@ViewBag.DateFrom" placeholder="From" style="width:auto;" />
            <input type="date" name="dateTo" class="form__input" value="@ViewBag.DateTo" placeholder="To" style="width:auto;" />
            <button type="submit" class="btn btn--outline-secondary" style="padding-top:var(--space-3);padding-bottom:var(--space-3);">Filter</button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string) || ViewBag.ProjectId != null || ViewBag.DateFrom != null || ViewBag.DateTo != null)
            {
                <a asp-action="Index" class="btn btn--ghost" style="color:var(--color-danger);">Clear</a>
            }
        </form>
    </div>

    @if (!Model.Any())
    {
        @if (!string.IsNullOrEmpty(ViewBag.Search as string) || ViewBag.ProjectId != null || ViewBag.DateFrom != null || ViewBag.DateTo != null)
        {
            <div class="card__body">
                <div class="alert alert--warning">
                    No time entries match your search. <a asp-action="Index">Clear filters</a> to see all entries.
                </div>
            </div>
        }
        else
        {
            <div class="card__body">
                <div class="alert alert--info">
                    You don't have any time entries yet. <a asp-action="Create">Log your first hours</a> to get started.
                </div>
            </div>
        }
    }
    else
    {
        <div class="card__body" style="padding-top:var(--space-4);padding-bottom:var(--space-4);border-bottom:1px solid var(--color-neutral-200);">
            <div class="text-muted text-sm">
                Total: <strong style="color:var(--color-text-primary);">@Model.Sum(t => t.Hours).ToString("N2") hours</strong> logged
                &middot; <strong style="color:var(--color-brand-700);">R @Model.Where(t => !t.IsInvoiced).Sum(t => t.Hours * (t.Project?.HourlyRate ?? 0)).ToString("N2")</strong> uninvoiced
            </div>
        </div>
        <div class="card__body card__body--flush">
            <div class="table-wrapper" style="border:none;box-shadow:none;border-radius:0;">
                <table class="table">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Date)</th>
                            <th>Client / Project</th>
                            <th>@Html.DisplayNameFor(model => model.Description)</th>
                            <th class="text-end">@Html.DisplayNameFor(model => model.Hours)</th>
                            <th class="text-end">Amount</th>
                            <th>@Html.DisplayNameFor(model => model.IsInvoiced)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.IsInvoiced ? "table-muted" : "")">
                                <td>@item.Date.ToString("dd MMM yyyy")</td>
                                <td>
                                    <strong>@item.Project?.Client?.Name</strong><br />
                                    <small class="text-muted">@item.Project?.Name</small>
                                </td>
                                <td>@(item.Description ?? "-")</td>
                                <td class="text-end">@item.Hours.ToString("N2")</td>
                                <td class="text-end">R @((item.Hours * (item.Project?.HourlyRate ?? 0)).ToString("N2"))</td>
                                <td>
                                    @if (item.IsInvoiced)
                                    {
                                        <span class="badge badge--neutral">Invoiced</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge--success">Pending</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button type="button" class="dropdown__trigger" data-dropdown-trigger
                                                aria-haspopup="true" aria-expanded="false"
                                                aria-label="Actions for entry on @item.Date.ToString("dd MMM yyyy")">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <circle cx="12" cy="5" r="1"/>
                                                <circle cx="12" cy="12" r="1"/>
                                                <circle cx="12" cy="19" r="1"/>
                                            </svg>
                                        </button>
                                        <div class="dropdown__menu" role="menu">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="dropdown__item" role="menuitem">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                </svg>
                                                Edit
                                            </a>
                                            <div class="dropdown__divider" role="separator"></div>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="dropdown__item dropdown__item--danger" role="menuitem">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <polyline points="3 6 5 6 21 6"/>
                                                    <path d="M19 6l-1 14H6L5 6"/>
                                                </svg>
                                                Delete
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card__footer">
            <div class="pagination" aria-label="Pagination">
                <span class="pagination__info">Showing 1 to @Model.Count() of @Model.Count() entries</span>
                <button type="button" class="pagination__btn" aria-label="Previous page" disabled>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <button type="button" class="pagination__btn pagination__btn--active" aria-label="Page 1" aria-current="page">1</button>
                <button type="button" class="pagination__btn" aria-label="Next page" disabled>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            </div>
        </div>
    }
</div>
