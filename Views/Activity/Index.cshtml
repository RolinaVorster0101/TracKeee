@model List<TracKeee.Models.ActivityLog>

@{
    ViewData["Title"] = "Activity Log";
}

<div class="page__header">
    <div>
        <h1 class="page__title">Activity Log</h1>
        <p class="page__subtitle">A record of everything happening in your organization.</p>
    </div>
</div>

<div class="card">
    <div class="card__header">
        <form method="get" style="margin:0;display:flex;align-items:center;gap:var(--space-3);flex-wrap:wrap;width:100%;">
            <select name="entityType" class="form__select" style="width:auto;" onchange="this.form.submit()">
                <option value="">All Types</option>
                <option value="Client" selected="@(ViewBag.EntityType == "Client")">Clients</option>
                <option value="Project" selected="@(ViewBag.EntityType == "Project")">Projects</option>
                <option value="TimeEntry" selected="@(ViewBag.EntityType == "TimeEntry")">Time Entries</option>
                <option value="Invoice" selected="@(ViewBag.EntityType == "Invoice")">Invoices</option>
                <option value="Team" selected="@(ViewBag.EntityType == "Team")">Team</option>
            </select>
            <input type="date" name="dateFrom" class="form__input" value="@ViewBag.DateFrom" aria-label="From date" style="width:auto;" />
            <input type="date" name="dateTo" class="form__input" value="@ViewBag.DateTo" aria-label="To date" style="width:auto;" />
            <button type="submit" class="btn btn--outline-secondary" style="padding-top:var(--space-3);padding-bottom:var(--space-3);">Filter</button>
            @if (!string.IsNullOrEmpty(ViewBag.EntityType as string) || ViewBag.DateFrom != null || ViewBag.DateTo != null)
            {
                <a asp-action="Index" class="btn btn--ghost" style="color:var(--color-danger);">Clear</a>
            }
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="card__body">
            <div class="alert alert--info">No activity recorded yet.</div>
        </div>
    }
    else
    {
        <div class="card__body card__body--flush">
            <div class="table-wrapper" style="border:none;box-shadow:none;border-radius:0;">
                <table class="table">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Type</th>
                            <th>Name</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>
                                    <small>@log.Timestamp.ToLocalTime().ToString("dd MMM yyyy")</small><br />
                                    <small class="text-muted">@log.Timestamp.ToLocalTime().ToString("HH:mm")</small>
                                </td>
                                <td><small>@log.UserEmail</small></td>
                                <td>
                                    <span class="badge @GetActionBadge(log.Action)">@log.Action</span>
                                </td>
                                <td>@log.EntityType</td>
                                <td><strong>@(log.EntityName ?? "-")</strong></td>
                                <td><small class="text-muted">@(log.Details ?? "-")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card__footer">
            <div class="pagination" aria-label="Pagination">
                <span class="pagination__info">Showing 1 to @Model.Count() of @Model.Count() entries</span>
                <button type="button" class="pagination__btn" aria-label="Previous page" disabled>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <button type="button" class="pagination__btn pagination__btn--active" aria-label="Page 1" aria-current="page">1</button>
                <button type="button" class="pagination__btn" aria-label="Next page" disabled>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            </div>
        </div>
    }
</div>

@functions {
    string GetActionBadge(string action)
    {
        return action switch
        {
            "Created" => "badge--success",
            "Updated" => "badge--info",
            "Deleted" => "badge--danger",
            "Generated" => "badge--info",
            "Sent" => "badge--info",
            "Paid" => "badge--success",
            "Emailed" => "badge--info",
            "Exported" => "badge--warning",
            "Downloaded" => "badge--neutral",
            "Invited" => "badge--success",
            "Changed Role" => "badge--warning",
            "Removed" => "badge--danger",
            _ => "badge--neutral"
        };
    }
}
