@model TracKeee.Models.Project

@{
    ViewData["Title"] = "Edit Project";
}

<div class="page__header">
    <div>
        <h1 class="page__title">Edit Project</h1>
        <p class="page__subtitle">Update this project's details.</p>
    </div>
</div>

<div>
    <div class="card">
        <div class="card__body">
            <form asp-action="Edit" class="form">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                <input type="hidden" asp-for="Id" />

                <div class="form__group">
                    <label asp-for="Name" class="form__label"></label>
                    <input asp-for="Name" class="form__input" />
                    <span asp-validation-for="Name" class="form__error"></span>
                </div>

                <div class="form__group">
                    <label asp-for="ClientId" class="form__label"></label>
                    <select asp-for="ClientId" class="form__select" asp-items="ViewBag.ClientId">
                        <option value="">-- Select a client --</option>
                    </select>
                    <span asp-validation-for="ClientId" class="form__error"></span>
                </div>

                <div class="form__group">
                    <label asp-for="Description" class="form__label"></label>
                    <textarea asp-for="Description" class="form__textarea" rows="3"></textarea>
                    <span asp-validation-for="Description" class="form__error"></span>
                </div>

                <div class="form__row form__row--2">
                    <div class="form__group">
                        <label asp-for="HourlyRate" class="form__label"></label>
                        <input asp-for="HourlyRate" class="form__input" />
                        <span asp-validation-for="HourlyRate" class="form__error"></span>
                    </div>

                    <div class="form__group">
                        <label asp-for="Status" class="form__label"></label>
                        <select asp-for="Status" class="form__select" asp-items="Html.GetEnumSelectList<TracKeee.Models.ProjectStatus>()"></select>
                        <span asp-validation-for="Status" class="form__error"></span>
                    </div>
                </div>

                <div class="form__row form__row--2">
                    <div class="form__group">
                        <label asp-for="StartDate" class="form__label"></label>
                        <input asp-for="StartDate" class="form__input" />
                        <span asp-validation-for="StartDate" class="form__error"></span>
                    </div>

                    <div class="form__group">
                        <label asp-for="DueDate" class="form__label"></label>
                        <input asp-for="DueDate" class="form__input" />
                        <span asp-validation-for="DueDate" class="form__error"></span>
                    </div>
                </div>

                <div class="form__actions">
                    <input type="submit" value="Save Changes" class="btn btn--primary" />
                    <a asp-action="Index" class="btn btn--secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
