@model TracKeee.Models.Project

@{
    ViewData["Title"] = "Project Details";
}

<div class="page__header">
    <div>
        <h1 class="page__title">@Model.Name</h1>
        <p class="page__subtitle">Project details</p>
    </div>
    <div class="page__actions">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn--primary">Edit</a>
        <a asp-action="Index" class="btn btn--secondary">Back to List</a>
    </div>
</div>

<div>
    <div class="card">
        <div class="card__body">
            <dl class="dl">
                <dt>@Html.DisplayNameFor(model => model.Client)</dt>
                <dd>@Model.Client?.Name</dd>

                <dt>@Html.DisplayNameFor(model => model.Description)</dt>
                <dd>@(Model.Description ?? "-")</dd>

                <dt>@Html.DisplayNameFor(model => model.HourlyRate)</dt>
                <dd>R @Model.HourlyRate.ToString("N2")</dd>

                <dt>@Html.DisplayNameFor(model => model.Status)</dt>
                <dd><span class="badge @GetStatusBadgeClass(Model.Status)">@Model.Status</span></dd>

                <dt>@Html.DisplayNameFor(model => model.StartDate)</dt>
                <dd>@(Model.StartDate?.ToString("dd MMM yyyy") ?? "-")</dd>

                <dt>@Html.DisplayNameFor(model => model.DueDate)</dt>
                <dd>@(Model.DueDate?.ToString("dd MMM yyyy") ?? "-")</dd>

                <dt>@Html.DisplayNameFor(model => model.CreatedAt)</dt>
                <dd>@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
            </dl>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(TracKeee.Models.ProjectStatus status)
    {
        return status switch
        {
            TracKeee.Models.ProjectStatus.Active => "badge--success",
            TracKeee.Models.ProjectStatus.OnHold => "badge--warning",
            TracKeee.Models.ProjectStatus.Completed => "badge--neutral",
            TracKeee.Models.ProjectStatus.Cancelled => "badge--danger",
            _ => "badge--neutral"
        };
    }
}
