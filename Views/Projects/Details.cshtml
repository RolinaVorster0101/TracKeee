@model TracKeee.Models.Project

@{
    ViewData["Title"] = "Project Details";
}

<h1>@Model.Name</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Client)</dt>
    <dd class="col-sm-9">@Model.Client?.Name</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Description)</dt>
    <dd class="col-sm-9">@(Model.Description ?? "-")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.HourlyRate)</dt>
    <dd class="col-sm-9">R @Model.HourlyRate.ToString("N2")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StartDate)</dt>
    <dd class="col-sm-9">@(Model.StartDate?.ToString("dd MMM yyyy") ?? "-")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DueDate)</dt>
    <dd class="col-sm-9">@(Model.DueDate?.ToString("dd MMM yyyy") ?? "-")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
</dl>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>