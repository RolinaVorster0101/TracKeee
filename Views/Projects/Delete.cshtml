@model TracKeee.Models.Project

@{
    ViewData["Title"] = "Delete Project";
}

<div class="page__header">
    <div>
        <h1 class="page__title">Delete Project</h1>
        <p class="page__subtitle">Review the details before confirming.</p>
    </div>
</div>

<div>
    <div class="alert alert--danger mb-4">
        <div>
            <strong>Are you sure you want to delete this project?</strong><br />
            This action cannot be undone.
        </div>
    </div>

    <div class="card">
        <div class="card__body">
            <dl class="dl">
                <dt>@Html.DisplayNameFor(model => model.Name)</dt>
                <dd>@Html.DisplayFor(model => model.Name)</dd>

                <dt>@Html.DisplayNameFor(model => model.Client)</dt>
                <dd>@Model.Client?.Name</dd>

                <dt>@Html.DisplayNameFor(model => model.HourlyRate)</dt>
                <dd>R @Model.HourlyRate.ToString("N2")</dd>

                <dt>@Html.DisplayNameFor(model => model.Status)</dt>
                <dd>@Model.Status</dd>

                <dt>@Html.DisplayNameFor(model => model.StartDate)</dt>
                <dd>@(Model.StartDate?.ToString("dd MMM yyyy") ?? "-")</dd>

                <dt>@Html.DisplayNameFor(model => model.DueDate)</dt>
                <dd>@(Model.DueDate?.ToString("dd MMM yyyy") ?? "-")</dd>
            </dl>
        </div>
        <div class="card__footer">
            <form asp-action="Delete" class="form__actions" style="margin:0;">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn--danger">Delete Project</button>
                <a asp-action="Index" class="btn btn--secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
