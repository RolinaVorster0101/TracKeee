@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="auth-page">
    <div class="auth-card" style="text-align:center;">
        @{
            if (User.Identity?.IsAuthenticated ?? false)
            {
                <h1 class="auth-card__title">Log out</h1>
                <p class="auth-card__subtitle">Are you sure you want to log out?</p>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                    <button type="submit" class="btn btn--primary btn--lg btn--full">Log out</button>
                </form>
            }
            else
            {
                <div style="display:flex;flex-direction:column;align-items:center;gap:var(--space-4);">
                    <div style="width:56px;height:56px;border-radius:var(--radius-full);background:var(--color-success-bg);color:var(--color-success);display:flex;align-items:center;justify-content:center;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </div>
                    <h1 class="auth-card__title" style="margin:0;">Logged out</h1>
                    <p class="auth-card__subtitle" style="margin:0;">You have successfully logged out of TracKeee.</p>
                    <a href="/" class="btn btn--primary btn--lg btn--full">Back to Home</a>
                </div>
            }
        }
    </div>
</div>
